{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "POS",
  "version": "0.1.17",
  "identifier": "com.cybsoc.pos.erp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm vite",
"beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "title": "POS",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/saimahmedqazi/POS/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQzRBNDdCMkVBMDFDOEIKUldTTEhLQXVlNlRFWVlXUWhDY09iM0FPRjZFNHQvb3dIYUx3dEw0MGVNeFN2cVRNRG1PYUNOU0gK"
    }
  }
}
