{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "os:allow-hostname",
    "os:allow-platform",
    "os:allow-arch",
    "os:allow-version",
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "process:allow-restart",
    "fs:scope-appdata-recursive",
    "fs:scope-home-recursive",
    "process:default",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:default",
    "updater:allow-check"
  ]
}